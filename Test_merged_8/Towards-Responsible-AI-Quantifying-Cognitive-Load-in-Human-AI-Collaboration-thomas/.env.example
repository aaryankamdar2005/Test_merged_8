GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant
OPENAI_API_KEY=sk_your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8002
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
HOST_USERNAME=host
HOST_PASSWORD=replace-with-a-long-random-host-password
DASHBOARD_USERNAME=dashboard
DASHBOARD_PASSWORD=replace-with-a-long-random-dashboard-password
TOKEN_TTL_MINUTES=60

DATABASE_URL=sqlite:///data/cognitrack.db

RAG_VECTOR_BACKEND=sqlite
RAG_EVALUATOR=native

# OCR is used only for scanned/image-only PDF pages during RAG ingestion.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=200
# Windows example: TESSERACT_CMD=C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=

# Use a long random value so participant tokens remain valid across backend restarts.
PARTICIPANT_TOKEN_SECRET=replace-with-a-long-random-secret
